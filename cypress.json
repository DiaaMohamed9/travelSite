{
   "defaultCommandTimeout": 10000,
   "testFiles": [
      "**/*.js"
   ],
   "reporter": "../node_modules/mochawesome/src/mochawesome.js",
   "reporterOptions": {
     "overwrite": false,
     "html": false,
     "json": true
   },
   "screenshotsFolder": "TestReport/assets",

   "screenshotOnRunFailure": true,
   "viewportHeight": 960,
   "viewportWidth": 1536,
   "video": false,
   "ignoreTestFiles": [
      "**/tests/accessControl/**",
      "**/pages/**",
      "**/commonTestCases/**",
      "**/API/**",
      "**/UI/**",
      "**/MongoDB/**",
      "**/Blitz.test.js",
      "**/functions.js"
   ],
   "requestTimeout": 10000,
   "retries": {
      "runMode": 0,
      "openMode": 0
   }
}