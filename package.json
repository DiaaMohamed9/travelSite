{
   "name": "saas-platform-e2e",
   "version": "1.0.0",
   "description": "E2E Tests for saas-platform",
   "main": "index.js",
   "scripts": {
      "clean:reports": "rm -rf mochawesome-report/ && rm -rf TestReport/",
      "test": "npm run clean:reports &&  npx cypress run || true && npm run generate:html:report",
      "merge:reports": "mochawesome-merge mochawesome-report/*.json > cypress-tests-report.json",
      "create:html:report": "marge --reportDir TestReport cypress-tests-report.json",
      "generate:html:report": "npm run merge:reports && npm run create:html:report"
    },
   "author": "",
   "license": "ISC",
   "devDependencies": {
      "cypress": "^9.5.1",
      "cypress-downloadfile": "^1.2.1",
      "cypress-file-upload": "^5.0.8",
      "cypress-localstorage-commands": "^1.4.5",
      "cypress-xpath": "^1.6.2",
      "faker": "^5.5.3",
      "fs-extra": "^9.1.0",
      "minimist": "^1.2.5",
      "mocha": "^7.2.0",
      "mochawesome": "^6.1.1",
      "mochawesome-merge": "^4.1.0",
      "mochawesome-report-generator": "^5.1.0"
   },
   "dependencies": {
      "@google-cloud/pubsub": "^2.18.2",
      "@sum.cumo/cypress-testrail-reporter": "^1.6.1",
      "@testing-library/cypress": "^8.0.1",
      "@testing-library/react": "^12.1.2",
      "@turf/turf": "^6.5.0",
      "@types/cypress": "^1.1.3",
      "await-spawn": "^4.0.2",
      "bson-ext": "^4.0.2",
      "convert-excel-to-json": "^1.7.0",
      "cypress-mochawesome-reporter": "^2.3.0",
      "cypress-tags": "^0.3.0",
      "date-and-time": "^1.0.1",
      "date-fns": "^2.28.0",
      "form-data": "^4.0.0",
      "mocha": "^9.2.1",
      "mocha-list-tests": "^1.1.0",
      "mochawesome": "^7.1.2",
      "moment": "^2.29.3",
      "moment-timezone": "^0.5.34",
      "mongodb": "^4.1.4",
      "mongodb-client-encryption": "^1.2.7",
      "patch-package": "^6.4.7",
